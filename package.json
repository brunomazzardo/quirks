{
  "name": "@quirks/monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "A local control plane for planning, dispatching, and understanding agent work.",
  "type": "module",
  "scripts": {
    "quirks": "bun run src/main.ts",
    "test:legacy": "bun test",
    "dev:desktop": "vp run --filter @quirks/desktop dev",
    "start:desktop": "vp run --filter @quirks/desktop start",
    "dist:desktop": "vp run --filter @quirks/desktop dist",
    "dist:desktop:dir": "vp run --filter @quirks/desktop dist:dir",
    "build": "vp run --filter './apps/*' --filter './packages/*' build",
    "typecheck": "vp run -r --concurrency-limit 2 typecheck",
    "tc": "vp run -r --concurrency-limit 2 typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "test": "vp run -r test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "^5.6.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.13"
  },
  "packageManager": "pnpm@11.10.0"
}
