.{
    .id = "dev.quirks.workbench",
    .name = "workbench",
    .display_name = "Quirks Workbench",
    .description = "Quirks daily driver — ledger, terminal, preview.",
    .version = "0.1.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{"macos"},
    // "command" is required for Cmd.ptySpawn — without it the spawn is
    // rejected and the terminal looks like a wrong-key orphan (QK-NAT-005).
    .permissions = .{ "view", "command" },
    .capabilities = .{ "native_views", "gpu_surfaces", "webview" },
    // NAT-009: soundboard-ts theme channel — geist pack + night-ledger lamp.
    .theme = "geist",
    .theme_accent = "#e5a83d",
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "Quirks",
                .width = 1280,
                .height = 800,
                .min_width = 960,
                .min_height = 560,
                .restore_state = false,
                .restore_policy = "center_on_primary",
                // NAT-010: markup header IS the titlebar (notes/soundboard).
                .titlebar = "hidden_inset_tall",
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Workbench canvas", .accessibility_label = "Workbench", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                    // Child webview; web_panes parks it at 1×1 when Shape is
                    // closed and snaps to preview-pane when open (NAT-008).
                    .{ .label = "preview", .kind = "webview", .parent = "main-canvas", .url = "http://127.0.0.1:47301/shape/", .x = 0, .y = 0, .width = 1, .height = 1 },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline", "http://127.0.0.1:47301", "http://127.0.0.1", "http://localhost" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
}
