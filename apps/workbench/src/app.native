<!-- Quirks workbench — NAT-009 theme, NAT-010 chrome, NAT-011 ledger polish.
     Notes/soundboard patterns: surface header + hairline, surface rail,
     consistent section headers (not mixed accordion/button sizes), rich type.
     Single <terminal> (NAT-005). Shape closed → rightSplit 1.0 (NAT-008). -->
<column grow="1" background="background">
  <row
    height="{headerHeight}"
    padding="12"
    gap="12"
    cross="center"
    background="surface"
    window-drag="true"
    label="Workbench header"
  >
    <spacer width="{chromeLeading}" />
    <text label="Quirks">
      <span weight="bold" scale="1.2">Quirks</span>
    </text>
    <spacer grow="1" />
    <badge variant="secondary">{ledgerStatus}</badge>
    <button
      size="sm"
      variant="outline"
      icon="panel-right"
      selected="{shapeOpen}"
      on-press="toggleShape"
    >Shape</button>
    <spacer width="{chromeTrailing}" />
  </row>
  <separator />
  <split value="{leftSplit}" on-resize="leftResized" gap="1" grow="1">
    <column width="280" min-width="220" background="surface" padding="10" gap="8">
      <row gap="8" cross="center" padding="2">
        <text foreground="text_muted" grow="1">Ledger</text>
      </row>
      <scroll grow="1" label="Ledger list">
        <column gap="6">
          <!-- Goals section — same control height as Tasks (aligned headers). -->
          <list-item
            on-press="toggleGoals"
            selected="{goalsOpen}"
            height="36"
            padding="8"
            gap="8"
            cross="center"
            label="Goals section"
          >
            <if test="{goalsOpen}">
              <icon name="chevron-down" width="14" height="14" foreground="text_muted" />
            </if>
            <else>
              <icon name="chevron-right" width="14" height="14" foreground="text_muted" />
            </else>
            <text grow="1">
              <span weight="medium">Goals</span>
            </text>
            <badge variant="secondary">{goalCount}</badge>
          </list-item>
          <if test="{goalsOpen}">
            <column gap="2">
              <for each="goals" key="id" as="g">
                <list-item
                  on-press="selectGoal:{g.id}"
                  selected="{g.selected}"
                  padding="10"
                  gap="8"
                  cross="center"
                  label="{g.title}"
                >
                  <text grow="1" wrap="false">{g.title}</text>
                  <if test="{g.tone == 'live'}">
                    <badge variant="primary">{g.status}</badge>
                  </if>
                  <else>
                    <badge variant="secondary">{g.status}</badge>
                  </else>
                </list-item>
              </for>
            </column>
          </if>

          <!-- Tasks section — identical header chrome to Goals. -->
          <list-item
            on-press="toggleTasks"
            selected="{tasksOpen}"
            height="36"
            padding="8"
            gap="8"
            cross="center"
            label="Tasks section"
          >
            <if test="{tasksOpen}">
              <icon name="chevron-down" width="14" height="14" foreground="text_muted" />
            </if>
            <else>
              <icon name="chevron-right" width="14" height="14" foreground="text_muted" />
            </else>
            <text grow="1">
              <span weight="medium">Tasks</span>
            </text>
            <badge variant="secondary">{taskCount}</badge>
          </list-item>
          <if test="{tasksOpen}">
            <column gap="2">
              <for each="tasks" key="id" as="t">
                <list-item
                  on-press="selectTask:{t.id}"
                  selected="{t.selected}"
                  padding="10"
                  label="{t.title}"
                >
                  <column gap="3" grow="1">
                    <row gap="8" cross="center">
                      <text grow="1" wrap="false">{t.title}</text>
                      <if test="{t.tone == 'live'}">
                        <badge variant="primary">{t.status}</badge>
                      </if>
                      <else>
                        <badge variant="secondary">{t.status}</badge>
                      </else>
                    </row>
                    <text>
                      <span mono foreground="text_muted">{t.id}</span>
                    </text>
                  </column>
                </list-item>
              </for>
            </column>
          </if>

          <separator />
          <row gap="8" cross="center" padding="8" height="36">
            <icon name="circle-dot" width="14" height="14" foreground="text_muted" />
            <text grow="1" foreground="text_muted">Runs</text>
            <badge variant="secondary">soon</badge>
          </row>
        </column>
      </scroll>
    </column>
    <split
      value="{rightSplit}"
      on-resize="rightResized"
      gap="1"
      grow="1"
      resize-duration="180"
      resize-easing="emphasized"
    >
      <terminal
        pty="{shellKey}"
        on-terminal="termState"
        autofocus="true"
        grow="1"
        min-width="280"
        focus-ring="background"
        label="Shell"
      />
      <panel grow="1" min-width="0" background="background" label="preview-pane"></panel>
    </split>
  </split>
</column>
