{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quirks://schemas/ui-approval-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "envelopeDigest", "approvalToken"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "campaignId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "envelopeDigest": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9._-]{1,128}$",
      "maxLength": 135
    },
    "approvalToken": {
      "type": "string",
      "pattern": "^qkui_[A-Za-z0-9_-]{43}$",
      "maxLength": 48
    }
  }
}
