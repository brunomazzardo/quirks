{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quirks://schemas/ui-prompt-set-v1",
  "type": "object",
  "required": ["schemaVersion", "context", "recommendedRecipeId", "recipes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "context": {
      "type": "object",
      "required": ["kind", "campaignId", "taskId", "state"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["campaign", "task", "plan", "review"] },
        "campaignId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "taskId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "state": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "recommendedRecipeId": {
      "oneOf": [{ "$ref": "#/$defs/recipeId" }, { "type": "null" }]
    },
    "recipes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/renderedPrompt" }
    }
  },
  "$defs": {
    "recipeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "renderedPrompt": {
      "type": "object",
      "required": [
        "recipeId",
        "recipeVersion",
        "label",
        "description",
        "prompt",
        "target",
        "bindings",
        "warnings",
        "authority"
      ],
      "additionalProperties": false,
      "properties": {
        "recipeId": { "$ref": "#/$defs/recipeId" },
        "recipeVersion": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "target": {
          "type": "object",
          "required": ["profileId", "runnerKind", "model", "independentFromProfileId"],
          "additionalProperties": false,
          "properties": {
            "profileId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
            "runnerKind": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
            "model": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
            "independentFromProfileId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
          }
        },
        "bindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["kind", "label", "value"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["campaign", "task", "plan-task", "path", "commit", "skill"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 128 },
              "value": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "authority": { "enum": ["read-only", "state-changing"] }
      }
    }
  }
}
